{
  "manifest_version": 3,
  "name": "TaskTape – Record & Replay Browser Tasks",
  "short_name": "TaskTape",
  "version": "1.0.0",
  "description": "Record the clicks and typing you repeat every day in your browser, then replay them in one click.",
  "author": "Duru Ugochukwu",
  "homepage_url": "https://github.com/uuduru/TaskTape",
  "permissions": ["storage", "scripting"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_start"
    }
  ],
  "action": {
    "default_title": "TaskTape",
    "default_popup": "popup.html"
  },
  "options_page": "editor.html"
}
